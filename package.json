{
  "name": "letter-service",
  "version": "1.0.0",
  "description": "Express API to serve letter generation functions, and worker node to monitor SQS",
  "scripts": {
    "dev:api": "nodemon main/server.js",
    "dev:worker": "nodemon worker/index.js",
    "start:api": "node main/server.js",
    "start:worker": "node worker/index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start:worker-local": "node ./local_deploy/localstack-init.js && npm run start:worker"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!./main/server.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "./**/*.js": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/client-sqs": "^3.978.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-openapi-validator": "^5.6.0",
    "morgan": "^1.10.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-std-serializers": "^7.0.0",
    "q-letter-transformer": "github:CriminalInjuriesCompensationAuthority/q-letter-transformer#bp-feature/interpolator-fix",
    "swagger-ui-express": "^5.0.1",
    "verror": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "aws-sdk-client-mock": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-openapi": "^0.14.2",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.8"
  }
}
