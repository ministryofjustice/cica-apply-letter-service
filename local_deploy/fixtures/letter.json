      "p--review-confirmation": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confirmation": {
              "title": "Confirmation",
              "description": "{{ govukPanel({\n                                  titleText: \"We\u0027ve received your request\"\n                                })}}\n                                \u003cp class\u003d\"govuk-body\"\u003eThank you for asking for a review.\u003c/p\u003e\n                                \u003ch3 class\u003d\"govuk-heading-m\"\u003eNext steps\u003c/h2\u003e\n                                \u003cp class\u003d\"govuk-body\"\u003eA different case officer will look at your application again to see if the decision was accurate.\u003c/p\u003e\n                                \u003cp class\u003d\"govuk-body\"\u003eWe make most review decisions within 6 months. Sometimes it can take longer depending on the circumstances of your claim.\u003c/p\u003e\n                                \u003cp class\u003d\"govuk-body\"\u003eIf you do not agree with the review decision, you can appeal to a tribunal. When we send you our review decision, we\u0027ll let you know how to do this.\u003c/p\u003e\n                                \u003ch3 class\u003d\"govuk-heading-m\"\u003eContact us\u003c/h2\u003e\n                                \u003cp class\u003d\"govuk-body\"\u003e\u003ca href\u003d\"\" class\u003d\"govuk-link\"\u003eContact us if you have any queries\u003ca\u003e.\u003c/p\u003e\n                                  "
            }
          },
          "options": {
            "showBackButton": false
          }
        }
      },
      "p--sending-supporting-information": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context-sending-supporting-info": {
              "title": "Send supporting information",
              "description": "\n                    \u003cp class\u003d\"govuk-body\"\u003eIf you have information to support your review request, you must send it to us by post or email.\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eYou must do this by \u003cb\u003e11:59pm on ||/meta/personalisation/expiry-date||.\u003c/b\u003e\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eIt\u0027s fine to send us:\u003c/p\u003e\n                    \u003cul class\u003d\u0027govuk-list govuk-list--bullet\u0027\u003e\n                    \u003cli\u003ephotocopies of documents\u003c/li\u003e\n                    \u003cli\u003escanned documents\u003c/li\u003e\n                    \u003cli\u003eimages of documents you have taken with a mobile phone\u003c/li\u003e\n                    \u003c/ul\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eIt\u0027s better to send us copies of documents instead of the originals.\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eYou should include your CICA reference number on anything you send us. This is: ||/answers/system/case-reference||\u003c/p\u003e\n                    \u003cdiv class\u003d\"govuk-inset-text\"\u003e\n                        \u003ch3 class\u003d\"govuk-heading-m\"\u003eEmail\u003c/h2\u003e\n                        \u003cp class\u003d\"govuk-body\"\u003e\u003ca href\u003d\"mailto:info@cica.gov.uk\" target\u003d\"_blank\" rel\u003d\"noopener noreferrer\" class\u003d\"govuk-link\"\u003einfo@cica.gov.uk\u003c/a\u003e\u003c/p\u003e\n                        \u003ch3 class\u003d\"govuk-heading-m\"\u003eAddress\u003c/h2\u003e\n                        \u003cp class\u003d\"govuk-body\"\u003eCriminal Injuries Compensation Authority\n                        \u003cbr\u003e10 Clyde Place\n                        \u003cbr\u003eBuchanan Wharf\n                        \u003cbr\u003eGlasgow\n                        \u003cbr\u003eG5 8AQ\n                        \u003cbr\u003eUnited Kingdom\u003c/p\u003e\n                    \u003c/div\u003e\n                    "
            }
          },
          "meta": {
            "pageType": "context"
          }
        }
      },
      "p-why-do-you-want-a-review": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "q-why-do-you-want-a-review"
          ],
          "properties": {
            "q-why-do-you-want-a-review": {
              "type": "string",
              "title": "Tell us why you want a review",
              "description": "\u003cp class\u003d\"govuk-body\"\u003eExplain why you do not agree with our decision. Let us know if you:\u003c/p\u003e\n                        \u003cul class\u003d\u0027govuk-list govuk-list--bullet\u0027\u003e\n                        \u003cli\u003edo not think we’ve considered all the information you gave us\u003c/li\u003e\n                        \u003cli\u003ethink we’ve looked at the wrong information\u003c/li\u003e\n                        \u003cli\u003ehave any extra information you’d like to give us\u003c/li\u003e\n                        \u003cli\u003ethink our decision was wrong for another reason\u003c/li\u003e\n                        \u003c/ul\u003e\n                        \u003cp class\u003d\"govuk-body\"\u003eDo not include personal or financial information, like your National Insurance number or credit card details.\u003c/p\u003e\n                        ",
              "maxLength": 10000,
              "errorMessage": {
                "maxLength": "Reasons must be 10000 characters or less"
              },
              "meta": {
                "classifications": {
                  "theme": "request-a-review"
                },
                "summary": {
                  "title": "Tell us why you want a review"
                }
              }
            }
          },
          "errorMessage": {
            "required": {
              "q-why-do-you-want-a-review": "Enter your reasons for wanting a review"
            }
          }
        }
      },
      "p-deadline-for-review": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "q-reason-for-missing-review-deadline"
          ],
          "additionalProperties": false,
          "properties": {
            "q-reason-for-missing-review-deadline": {
              "type": "string",
              "title": "Deadline for asking for a review",
              "description": "\n                    \u003cp class\u003d\"govuk-body\"\u003eYou missed the deadline to ask for a review. The deadline was ||/meta/personalisation/expiry-date||.\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eWe can sometimes extend the time limit for reviews if there are exceptional circumstances.\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003eBefore we look at your reason for wanting a review, we\u0027ll decide whether to extend the time limit or not. If we decide not to extend the time limit, we will not review your case.\u003c/p\u003e\n                    \u003cp class\u003d\"govuk-body\"\u003e\u003cb\u003eWe can only extend the time limit once.\u003c/b\u003e If you\u0027ve already asked for an extension and have missed the deadline, we cannot consider your request for a review.\u003c/p\u003e\n                    \u003ch2 class\u003d\"govuk-heading-m\"\u003eTell us why you missed the deadline for asking for a review\u003c/h2\u003e\n                    ",
              "maxLength": 10000,
              "errorMessage": {
                "maxLength": "Reasons must be 10000 characters or less"
              },
              "meta": {
                "classifications": {
                  "theme": "request-a-review"
                }
              }
            }
          }
        }
      },
      "system": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "case-reference"
          ],
          "additionalProperties": false,
          "properties": {
            "case-reference": {
              "type": "string",
              "pattern": "^[0-9]{2}\\\\[0-9]{6}$",
              "errorMessage": {
                "pattern": "Invalid case reference"
              }
            },
            "letter-id": {
              "type": "string"
            },
            "letter-type": {
              "type": "string"
            },
            "expiry-date": {
              "type": "string"
            }
          },
          "errorMessage": {
            "required": "Case reference is required"
          }
        }
      },
      "owner": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "owner-id",
            "is-authenticated"
          ],
          "properties": {
            "owner-id": {
              "type": "string",
              "format": "uri",
              "maxLength": 64,
              "pattern": "^urn:(uuid|fdc:gov.uk:2022):"
            },
            "is-authenticated": {
              "type": "boolean"
            }
          },
          "errorMessage": {
            "required": {
              "owner-id": "Owner id is required",
              "is-authenticated": "isAuthenticated is required"
            }
          }
        }
      },
      "origin": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "channel"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]{0,19}(?:-[a-z0-9]{1,20}){0,20}$",
              "errorMessage": {
                "pattern": "Channel is not a valid format"
              }
            }
          },
          "errorMessage": {
            "required": {
              "channel": "Channel is required"
            }
          }
        }
      }
    },
    "routes": {
      "initial": "p--decision",
      "referrer": "https://www.gov.uk/claim-compensation-criminal-injury/make-claim",
      "summary": [
        "p--check-your-answers"
      ],
      "confirmation": "p--review-confirmation",
      "states": {
        "p--ask-for-a-review": {
          "on": {
            "ANSWER": [
              {
                "target": "p-deadline-for-review",
                "cond": [
                  "|role.all",
                  "expired"
                ]
              },
              {
                "target": "p-why-do-you-want-a-review"
              }
            ]
          }
        },
        "p--decision": {
          "on": {
            "ANSWER": [
              {
                "target": "p--ask-for-a-review"
              }
            ]
          }
        },
        "p-do-you-have-supporting-info": {
          "on": {
            "ANSWER": [
              {
                "target": "p--sending-supporting-information",
                "cond": [
                  "\u003d\u003d",
                  "$.answers.p-do-you-have-supporting-info.q-supporting-info",
                  true
                ]
              },
              {
                "target": "p--check-your-answers"
