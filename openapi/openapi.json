{
  "openapi": "3.0.3",
  "info": {
    "title": "Letter Service API",
    "version": "1.0.0",
    "description": "API for generating, sending, and managing letters."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "uptime": {
                      "type": "number",
                      "example": 123.45
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/letters/{userId}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "description": "Unique identifier of a user.",
          "schema": {
            "type": "string",
            "format": "uuid",
            "example": "223e4567-e89b-12d3-a456-426614174111"
          }
        }
      ],
      "get": {
        "summary": "Get all letters for a user",
        "description": "Returns all letters belonging to the specified user across all cases.",
        "tags": ["Letters"],
        "responses": {
          "200": {
            "description": "List of letters for the user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LetterResource"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error while retrieving letters."
          }
        }
      },
      "delete": {
        "summary": "Delete all letters for a user",
        "description": "Deletes all letters belonging to the specified user across all cases.",
        "tags": ["Letters"],
        "responses": {
          "204": {
            "description": "Delete request accepted."
          },
          "500": {
            "description": "Unexpected server error while processing the delete request."
          }
        }
      }
    },
    "/letters/{userId}/{caseReferenceNumber}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "description": "Unique identifier of the user.",
          "schema": {
            "type": "string",
            "format": "uuid",
            "example": "223e4567-e89b-12d3-a456-426614174111"
          }
        },
        {
          "name": "caseReferenceNumber",
          "in": "path",
          "required": true,
          "description": "Case reference number.",
          "schema": {
            "type": "string",
            "example": "25-70123"
          }
        }
      ],
      "get": {
        "summary": "Get all letters for a case",
        "description": "Returns all letters for a specific case belonging to a specific user.",
        "tags": ["Letters"],
        "responses": {
          "200": {
            "description": "List of letters for the case.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LetterResource"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error while retrieving letters for the case."
          }
        }
      },
      "delete": {
        "summary": "Delete all letters for a case",
        "description": "Deletes all letters for a specific case belonging to a specific user.",
        "tags": ["Letters"],
        "responses": {
          "204": {
            "description": "Delete request accepted."
          },
          "500": {
            "description": "Unexpected server error while processing the delete request."
          }
        }
      }
    },
    "/letters/{userId}/{caseReferenceNumber}/{letterId}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "description": "Unique identifier of the user.",
          "schema": {
            "type": "string",
            "format": "uuid",
            "example": "223e4567-e89b-12d3-a456-426614174111"
          }
        },
        {
          "name": "caseReferenceNumber",
          "in": "path",
          "required": true,
          "description": "Case reference number.",
          "schema": {
            "type": "string",
            "example": "25-700123"
          }
        },
        {
          "name": "letterId",
          "in": "path",
          "required": true,
          "description": "Unique identifier of the letter.",
          "schema": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        }
      ],
      "get": {
        "summary": "Get a specific letter",
        "description": "Returns the details of a specific letter for a given user and case.",
        "tags": ["Letters"],
        "responses": {
          "200": {
            "description": "Details of the requested letter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LetterResource"
                }
              }
            }
          },
          "404": {
            "description": "Letter not found."
          },
          "500": {
            "description": "Unexpected server error while retrieving the letter."
          }
        }
      },
      "delete": {
        "summary": "Delete a specific letter",
        "description": "Deletes a specific letter for a given user and case. If no matching letter is found, the request is still treated as successful and no content is returned.",
        "tags": ["Letters"],
        "responses": {
          "204": {
            "description": "Delete request accepted."
          },
          "500": {
            "description": "Unexpected server error while processing the delete request."
          }
        }
      }
    },
    "/letters/{userId}/{caseReferenceNumber}/{letterId}/send": {
      "post": {
        "summary": "Send a specific letter",
        "description": "Sends a specific letter to a user by email or text message, depending on the specified contact preference.",
        "tags": ["Letters"],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the user.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "223e4567-e89b-12d3-a456-426614174111"
            }
          },
          {
            "name": "caseReferenceNumber",
            "in": "path",
            "required": true,
            "description": "Case reference number.",
            "schema": {
              "type": "string",
              "example": "25-700123"
            }
          },
          {
            "name": "letterId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the letter.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174000"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendLetterRequest"
              },
              "example": {
                "letterType": "AA01",
                "letterData": {
                  "recipientName": "Mr Test Testcase",
                  "caseReference": "25-700123",
                  "decisionDate": "2024-01-15"
                },
                "contactPreference": "E",
                "userEmail": "user@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Send operation completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendLetterResponse"
                },
                "examples": {
                  "sent": {
                    "summary": "Successful send",
                    "value": {
                      "letterId": "123e4567-e89b-12d3-a456-426614174000",
                      "status": "sent"
                    }
                  },
                  "error": {
                    "summary": "Error sending letter",
                    "value": {
                      "letterId": "123e4567-e89b-12d3-a456-426614174000",
                      "status": "error"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload."
          },
          "500": {
            "description": "Unexpected server error while sending the letter."
          }
        }
      }
    },
    "/letters/{userId}/{caseReferenceNumber}/{letterId}/pdf": {
      "post": {
        "summary": "Generate a PDF for a specific letter",
        "description": "Generates a PDF for the specified letter, stores it in object storage, and returns a URI for the generated PDF. The isPreview flag controls whether a PREVIEW watermark is applied.",
        "tags": ["Letters"],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the user.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "223e4567-e89b-12d3-a456-426614174111"
            }
          },
          {
            "name": "caseReferenceNumber",
            "in": "path",
            "required": true,
            "description": "Case reference number.",
            "schema": {
              "type": "string",
              "example": "25-700123"
            }
          },
          {
            "name": "letterId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the letter.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174000"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateLetterRequest"
              },
              "example": {
                "letterType": "AA01",
                "letterData": {
                  "recipientName": "Mr Test Testcase",
                  "caseReference": "25-700123",
                  "decisionDate": "2026-01-15"
                },
                "isPreview": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PDF generated and stored successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateLetterResponse"
                },
                "example": {
                  "letterId": "123e4567-e89b-12d3-a456-426614174000",
                  "uri": "s3://letter-bucket/user123/case123/letter123.pdf"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload."
          },
          "500": {
            "description": "Error generating or storing the PDF."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LetterData": {
        "type": "object",
        "description": "Dynamic key-value pairs used to populate the letter template. Required fields will vary depending on letterType.",
        "additionalProperties": {
          "type": "string",
          "example": "Some value"
        },
        "example": {
          "recipientName": "Mr Test Testcase",
          "caseReference": "25-700123",
          "decisionDate": "2024-01-15"
        }
      },
      "LetterBase": {
        "type": "object",
        "required": ["letterType", "letterData"],
        "properties": {
          "letterType": {
            "type": "string",
            "description": "Code that identifies which letter template to use.",
            "example": "AA01"
          },
          "letterData": {
            "$ref": "#/components/schemas/LetterData"
          }
        }
      },
      "LetterResource": {
        "type": "object",
        "description": "Represents a stored letter and its associated metadata.",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the user who owns the letter.",
            "example": "223e4567-e89b-12d3-a456-426614174111"
          },
          "caseReferenceNumber": {
            "type": "string",
            "description": "Reference number of the case to which the letter belongs.",
            "example": "25-700123"
          },
          "letterId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the letter.",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "letterType": {
            "type": "string",
            "description": "Code that identifies which letter template was used.",
            "example": "AA01"
          },
          "letterData": {
            "$ref": "#/components/schemas/LetterData"
          },
          "jsonUri": {
            "type": "string",
            "description": "URI of the JSON representation of the letter in object storage.",
            "example": "s3://letter-bucket/user123/case123/letter123.json"
          },
          "pdfUri": {
            "type": "string",
            "nullable": true,
            "description": "URI of the generated PDF for this letter in object storage, if available.",
            "example": "s3://letter-bucket/user123/case123/letter123.pdf"
          }
        },
        "required": ["userId", "caseReferenceNumber", "letterId", "letterType", "letterData", "jsonUri"]
      },
      "GenerateLetterRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LetterBase"
          },
          {
            "type": "object",
            "required": ["isPreview"],
            "properties": {
              "isPreview": {
                "type": "boolean",
                "description": "Whether to generate the letter as a preview (with a PREVIEW watermark) or as a final version.",
                "example": true
              }
            }
          }
        ],
        "description": "Request payload for generating a letter PDF."
      },
      "GenerateLetterResponse": {
        "type": "object",
        "description": "Response returned after generating and storing a PDF for a letter.",
        "properties": {
          "letterId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the letter for which the PDF was generated.",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "uri": {
            "type": "string",
            "description": "URI pointing to the generated PDF in object storage (e.g. S3).",
            "example": "s3://letter-bucket/user123/case123/letter123.pdf"
          }
        },
        "required": ["letterId", "uri"]
      },
      "SendLetterRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LetterBase"
          },
          {
            "type": "object",
            "required": ["contactPreference"],
            "properties": {
              "contactPreference": {
                "type": "string",
                "description": "Preferred contact method: 'T' for text message, 'E' for email.",
                "enum": ["T", "E"],
                "example": "E"
              },
              "userEmail": {
                "type": "string",
                "format": "email",
                "nullable": true,
                "description": "Email address to send the letter to, required if contactPreference is 'E'.",
                "example": "user@example.com"
              },
              "userPhone": {
                "type": "string",
                "nullable": true,
                "description": "Phone number to send the letter to by text, required if contactPreference is 'T'.",
                "example": "+447700900123"
              }
            }
          }
        ],
        "description": "Request payload for sending a letter to a user."
      },
      "SendLetterResponse": {
        "type": "object",
        "description": "Result of attempting to send a letter.",
        "properties": {
          "letterId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the letter that was sent or attempted.",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "status": {
            "type": "string",
            "description": "Outcome of the send operation.",
            "enum": ["sent", "error"],
            "example": "sent"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true,
            "description": "Error details if the send operation failed. Null or omitted when status is 'sent'.",
            "example": "SMTP connection failed"
          }
        },
        "required": ["letterId", "status"]
      }
    }
  }
}
